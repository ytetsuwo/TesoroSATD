        String fromPhoneNumber = "(250) 590 2252";
        String documentStatus = "Cancelled";
        String documentStatusDate = "2008-06-26";

        String receiveFaxCoverPageYn = "Y";


        process(wsdlEndpoint,
                wsdlUsername,
                wsdlPassword,
                callbackEndpoint,
                callbackUsername,
                callbackPassword,
                from,
                to,
                jobId,
                sdateTime,
                timeout,
                schannel,
                transport,
                subject,
                fileNumber,
                snumPages,
                attachment,
                extension1,
                extension2,
                fromFaxNumber,
                fromPhoneNumber,
                documentStatus,
                documentStatusDate,
                receiveFaxCoverPageYn);
    }


}

