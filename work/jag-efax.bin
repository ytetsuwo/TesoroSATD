          "VulnerabilityID": "CVE-2023-0466",
          "VendorIDs": [
            "DSA-5417-1"
          ],
          "PkgID": "openssl@1.1.1n-0+deb11u3",
          "PkgName": "openssl",
          "InstalledVersion": "1.1.1n-0+deb11u3",
