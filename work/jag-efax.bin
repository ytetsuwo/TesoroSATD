		// assert the health check returns { "status" : "UP" } - this confirms the ws is up.
		
		JsonNode node = restTemplate.getForObject("/actuator/health", JsonNode.class);
		assertTrue(Status.UP.getCode().equals(node.get("status").asText()));		
	}
	
	@Disabled
