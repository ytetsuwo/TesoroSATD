          "VulnerabilityID": "CVE-2022-42252",
          "PkgName": "org.apache.tomcat.embed:tomcat-embed-core",
          "PkgPath": "app/service.jar/BOOT-INF/lib/tomcat-embed-core-9.0.46.jar",
          "InstalledVersion": "9.0.46",
          "FixedVersion": "8.5.83, 9.0.68, 10.0.27, 10.1.1",
          "Layer": {
            "DiffID": "sha256:6aea6d04cbd8263c006d1c0ea47e65565e271260e047bc1fdd762cf999726d66"
          },
