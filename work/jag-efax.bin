        if (hasAccountedTheFaxCoverPage)
            this.numPages += 1;

        return this;
    }

    public DocumentDistributionRequestBuilder setAttachments(String attachment) {
        if (attachment != null && !attachment.isEmpty())
            this.attachments.getUri().add(attachment);
        return this;
    }

