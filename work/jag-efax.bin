        {
          "VulnerabilityID": "CVE-2023-2650",
          "VendorIDs": [
            "DSA-5417-1"
          ],
          "PkgID": "libssl1.1@1.1.1n-0+deb11u3",
          "PkgName": "libssl1.1",
          "InstalledVersion": "1.1.1n-0+deb11u3",
