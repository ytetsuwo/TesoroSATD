        {
          "VulnerabilityID": "CVE-2022-42898",
          "VendorIDs": [
            "DSA-5286-1"
          ],
          "PkgID": "libgssapi-krb5-2@1.18.3-6+deb11u1",
          "PkgName": "libgssapi-krb5-2",
          "InstalledVersion": "1.18.3-6+deb11u1",
