<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>2.5.0</version>
		<relativePath /> <!-- lookup parent from repository -->
	</parent>

	<groupId>ca.bc.gov.ag</groupId>
	<artifactId>jag-efax</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>

	<name>jag-eFax</name>
	<description>A BPEL eFax Replacement project.</description>

	<properties>
		<java.version>1.8</java.version>
		<main.basedir>${project.basedir}</main.basedir>
	</properties>

	<modules>
		<module>mailservice-api</module>
		<module>doc-distrib-ws</module>
		<module>common</module>
		<module>fax-listener</module>
	</modules>

	<repositories>
		<repository>
			<id>nexus</id>
			<url>file:${file.separator}${file.separator}${main.basedir}${file.separator}nexus</url>
		</repository>
	</repositories>


	<profiles>
		<profile>
			<id>default</id>
			<modules>
				<module>common</module>
				<module>doc-distrib-ws</module>
				<module>mailservice-api</module>
				<module>fax-listener</module>
			</modules>
		</profile>
		<profile>
			<id>webservice</id>
			<modules>
				<module>common</module>
				<module>doc-distrib-ws</module>
			</modules>
		</profile>
		<profile>
			<id>mailservice</id>
			<modules>
				<module>common</module>
				<module>mailservice-api</module>
			</modules>
		</profile>
		<profile>
			<id>fax-listener</id>
			<modules>
				<module>common</module>
				<module>fax-listener</module>
			</modules>
		</profile>
	</profiles>
	
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>
		<dependency>
			<groupId>axis</groupId>
			<artifactId>axis</artifactId>
			<version>1.2.1</version>
			<exclusions>
				<exclusion>
					<groupId>javax.activation</groupId>
					<artifactId>activation</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>javax.mail</groupId>
			<artifactId>mail</artifactId>
			<version>1.4.5</version>
		</dependency>
		<dependency>
			<groupId>commons-io</groupId>
			<artifactId>commons-io</artifactId>
			<version>2.9.0</version>
		</dependency>
		<dependency>
			<groupId>commons-logging</groupId>
			<artifactId>commons-logging</artifactId>
			<version>1.2</version>
		</dependency>
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-collections4</artifactId>
			<version>4.4</version>
		</dependency>

		<!-- Custom dependencies -->
		<dependency>
			<groupId>ca.bc.gov.ag</groupId>
			<artifactId>ewsproxy</artifactId>
			<version>0.0.1</version>
		</dependency>
		<dependency>
			<groupId>ca.bc.gov.ag</groupId>
			<artifactId>jaxrpc</artifactId>
			<version>0.0.1</version>
		</dependency>
		<dependency>
			<groupId>ca.bc.gov.ag</groupId>
			<artifactId>outputservice</artifactId>
			<version>0.0.1</version>
		</dependency>
		<dependency>
			<groupId>ca.bc.gov.ag</groupId>
			<artifactId>xpaaj</artifactId>
			<version>0.0.1</version>
		</dependency>

		<!-- Test dependencies -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>it.ozimov</groupId>
			<artifactId>embedded-redis</artifactId>
			<version>0.7.3</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>

