        </dependency>
    </dependencies>

    <profiles>
    
        <profile>
            <id>java11</id>
            <activation>
                <jdk>[11,)</jdk>
            </activation>

            <dependencies>
            
                <dependency>
                    <groupId>org.glassfish.jaxb</groupId>
                    <artifactId>jaxb-runtime</artifactId>
                </dependency>
                
            </dependencies>
        </profile>
        <profile>
            <id>splunk</id>
            <activation>
                <property>
